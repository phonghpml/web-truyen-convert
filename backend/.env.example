# PostgreSQL connection string
DATABASE_URL=""

# Port chạy local (Mặc định FastAPI là 8000)
PORT=8000

# App / Auth
# Chế độ development chỉ cho phép fallback local an toàn; production bắt buộc có secret thật.
APP_ENV="development"
APP_SECRET=""
JWT_SECRET=""
JWT_ALGO="HS256"
COOKIE_SECURE=false

# JWT / access token (15 days = 15 * 24 * 60 * 60)
ACCESS_TOKEN_EXPIRE_SECONDS=1296000
REFRESH_TOKEN_EXPIRES_DAYS=30
REFRESH_TOKEN_EXPIRES_SECONDS=2592000

# Supabase Storage configuration
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="videos"
# Optional if you want to use anon key access instead of the service role key
# SUPABASE_ANON_KEY="sb_publishable_CfnJkZza3_CmhTS72LSYIw_ZTbTzWDH"

# YouTube OAuth configuration
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI=""

# YouTube upload metadata defaults
YOUTUBE_CHANNEL_NAME="Kênh Truyện Audio"
YOUTUBE_CHANNEL_URL="https://www.youtube.com/channel/your-channel"
YOUTUBE_PLAYLIST_NAME="Playlist Truyện Audio"
YOUTUBE_PLAYLIST_URL="https://www.youtube.com/playlist/your-playlist"
VIDEO_SUPPORT_EMAIL="support@example.com"
VIDEO_VOICE_LABEL="AI"
VIDEO_BOOK_STATUS="Đang ra"
VIDEO_COPYRIGHT_CHANNEL="Kênh Truyện Audio"

# CORS allowed origins (comma-separated)
FRONTEND_ORIGINS="http://localhost:3000"
